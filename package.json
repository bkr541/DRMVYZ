{
  "name": "drmvyz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "node scripts/run-electron-dev.mjs",
    "electron:start": "npm run build && electron . --production",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:dist:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win --publish never",
    "desktop:dist:linux": "npm run build && electron-builder --linux --publish never",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest-partitions.mjs",
    "test:native": "node --test native/**/*.test.cjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:diagnose": "vitest run --reporter=default --reporter=hanging-process",
    "test:bench": "vitest bench",
    "playwright:install": "playwright install chromium",
    "playwright:install:ci": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/test/e2e/smoke.spec.ts --project=chromium",
    "audit": "npm audit --audit-level=high",
    "verify:fast": "npm run repo:hygiene && npm run lint && npm run typecheck && npm run test:native && npm run test && npm run build",
    "verify": "npm run verify:fast && npm run playwright:install && npm run test:e2e:smoke && npm run audit",
    "package:source": "node scripts/create-source-archive.mjs",
    "verify:clean": "npm ci && npm run verify",
    "lint": "eslint . --max-warnings=25",
    "repo:hygiene": "node scripts/check-repository-hygiene.mjs",
    "clean:generated": "node scripts/clean-generated.mjs",
    "clean:all": "node scripts/clean-generated.mjs --dependencies",
    "test:e2e:shaders": "playwright test src/test/e2e/shaderCompilation.spec.ts --project=chromium",
    "visual:show-director": "node scripts/generate-show-director-visual-review.mjs",
    "visual:show-director:webgl": "node scripts/generate-show-director-webgl-visual-review.mjs",
    "test:node": "node scripts/run-vitest-partitions.mjs --node",
    "test:dom": "node scripts/run-vitest-partitions.mjs --dom",
    "test:webgl": "npm run visual:show-director:webgl",
    "test:electron": "npm run test:native",
    "test:edge": "deno test --allow-env supabase/functions/_shared/*.test.ts",
    "test:laser-dmx:physical": "vitest run src/components/vyzualz/react/renderers/laserDmx/LaserDmxScannerDomain.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxScannerWebGLPlan.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxAdaptiveQuality.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxWebGLRecovery.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxWebGLRuntime.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxPhysicalRealismAudit.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxWebGLVisualReferenceManifest.test.ts src/components/vyzualz/react/LaserDmxShowDirectorPhysicalContentMigration.test.ts src/components/vyzualz/react/LaserDmxShowDirectorFinalVisualValidation.test.ts",
    "verify:laser-dmx:physical": "npm run typecheck && npm run test:laser-dmx:physical && npm run test:webgl",
    "test:laser-dmx:realism": "vitest run src/components/vyzualz/react/LaserDmxShowDirectorPresetRealismValidation.test.ts src/components/vyzualz/react/laserDmxShowDirectorTemplates.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxWebGLVisualReferenceManifest.test.ts",
    "test:laser-dmx:programming": "vitest run src/components/vyzualz/react/LaserDmxShowDirectorProgramming.test.ts src/components/vyzualz/react/LaserDmxShowDirectorFirstPartyAuthoring.test.ts src/components/vyzualz/react/LaserDmxShowDirectorPresetRealismValidation.test.ts src/components/vyzualz/react/laserDmxShowDirectorTemplates.test.ts src/components/vyzualz/react/renderers/laserDmx/LaserDmxWebGLVisualReferenceManifest.test.ts",
    "verify:laser-dmx:programming": "npm run typecheck && npm run test:laser-dmx:programming && npm run test:webgl",
    "test:pix-grid:final": "npm run test:pix-grid:unit && npm run test:e2e:pix-grid-marquee-real && npm run test:e2e:pix-grid-deck-compiler && npm run test:e2e:pix-grid-deck-runtime",
    "verify:pix-grid:final": "npm run repo:hygiene && npm run typecheck && npm run test:pix-grid:final && npm run build",
    "test:pix-grid:perceptual": "vitest run src/components/vyzualz/react/pixGrid/__tests__/PixGridPerceptualAudioIntelligence.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridRenderedPixelRegression.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPerformanceProgramArchitecture.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPerceptualMagnitude.test.ts",
    "verify:pix-grid:recording": "node scripts/verify-pix-grid-screen-recording.mjs",
    "verify:pix-grid:release": "npm run verify:pix-grid:final && npm run verify:pix-grid:recording --",
    "test:e2e:pix-grid-marquee-stage3": "npm run test:e2e:pix-grid-marquee-real",
    "test:pix-grid:unit": "vitest run src/components/vyzualz/react/pixGrid/__tests__/PixGridCanonicalLayerGraphMigration.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridStateMigrationControls.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridRenderedPixelRegression.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridFinalReactivityWorkspace.test.tsx src/components/vyzualz/react/pixGrid/__tests__/PixGridPatch3ValidationAndDiagnostics.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPatch3FullSongDeterminism.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPerceptualAudioIntelligence.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPerceptualResponse.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridPerceptualMagnitude.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridNeonMarqueePreset.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridNeonMarqueeCanonicalStage1.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridNeonMarqueeAnimationPerformance.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridMarqueeAudioRouteConsolidation.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridNeonMarqueeAuditMovementPresentation.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridFrameLayerTransitions.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridMarqueeIndependentSignClock.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridSelectedScenePreviewTimeline.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridMarqueeBlackSquareAndSelectedSceneSeekCorrection.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridGpuRenderer.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridCanonicalGroupRecruitment.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridMarqueeStableLightUnderlays.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridEditingContextSceneOwnership.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridSemanticTarget.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckDomain.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckMediaValidation.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckBrandBackground.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckMediaService.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckProjectMedia.test.ts src/stores/pixGridPersistence.test.ts src/stores/pixGridDeckPersistence.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerCore.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompileCoordinator.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerPreflight.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckPreparedFrameCache.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerExecutor.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckMediaSourceResolver.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridSequenceClock.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckAudioPerformance.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckTransitionPlanner.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckTransitionCoordinator.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckRuntimeRendering.test.ts",
    "test:e2e:pix-grid-marquee-real": "node scripts/generate-pix-grid-marquee-stage3-browser.mjs",
    "test:e2e:pix-grid-deck-compiler": "node scripts/run-pix-grid-deck-compiler-browser.mjs",
    "test:e2e:pix-grid-deck-runtime": "node scripts/run-pix-grid-deck-runtime-browser.mjs",
    "test:pix-grid:deck-compiler": "vitest run src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerCore.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckPreparedFrameCache.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompileCoordinator.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerPreflight.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckMediaService.test.ts src/stores/pixGridDeckPersistence.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckCompilerExecutor.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckMediaSourceResolver.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridMediaConversion.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckTransitionPlanner.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckTransitionCoordinator.test.ts src/components/vyzualz/react/pixGrid/__tests__/PixGridDeckRuntimeRendering.test.ts",
    "verify:pix-grid:deck-compiler": "npm run typecheck && npm run test:pix-grid:deck-compiler && npm run test:e2e:pix-grid-deck-compiler && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "@wavesurfer/react": "^1.0.12",
    "essentia.js": "^0.1.3",
    "hugeicons-react": "^0.4.0",
    "konva": "^9.3.22",
    "meyda": "^5.6.3",
    "onnxruntime-web": "^1.26.0",
    "opentype.js": "^2.0.0",
    "peaks.js": "^3.4.2",
    "pitchy": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svg-path-properties": "^2.0.2",
    "tonal": "^6.4.3",
    "waveform-data": "^4.5.2",
    "wavesurfer.js": "^7.12.7",
    "web-audio-beat-detector": "^8.2.36",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "main": "electron/main.cjs",
  "optionalDependencies": {
    "rekordbox-parser": "^0.1.2"
  },
  "build": {
    "appId": "com.dvydrm.drmvyz",
    "productName": "DRMVYZ",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "icon": "public/drmvyz_logo2.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DRMVYZ uses microphone input only when you select the Microphone audio source."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/drmvyz_logo2.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "public/drmvyz_logo2.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  },
  "description": "Desktop VJ and audio-reactive visualization system for DVYDRM.",
  "author": "DVYDRM"
}
