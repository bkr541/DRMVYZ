{
  "name": "drmvyz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:diagnose": "vitest run --reporter=default --reporter=hanging-process",
    "test:bench": "vitest bench",
    "playwright:install": "playwright install chromium",
    "playwright:install:ci": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/test/e2e/smoke.spec.ts --project=chromium",
    "audit": "npm audit --audit-level=high",
    "verify:fast": "npm run typecheck && npm run test && npm run build",
    "verify": "npm run verify:fast && npm run playwright:install && npm run test:e2e:smoke && npm run audit",
    "package:source": "node scripts/create-source-archive.mjs",
    "verify:clean": "npm ci && npm run verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "@wavesurfer/react": "^1.0.12",
    "essentia.js": "^0.1.3",
    "hugeicons-react": "^0.4.0",
    "konva": "^9.3.22",
    "meyda": "^5.6.3",
    "onnxruntime-web": "^1.26.0",
    "opentype.js": "^2.0.0",
    "peaks.js": "^3.4.2",
    "pitchy": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svg-path-properties": "^2.0.2",
    "tonal": "^6.4.3",
    "waveform-data": "^4.5.2",
    "wavesurfer.js": "^7.12.7",
    "web-audio-beat-detector": "^8.2.36",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
