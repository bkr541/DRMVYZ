+      const sourceY = sourceComponent.centroidY / Math.max(1, source.height - 1)
+      const targetX = targetComponent.centroidX / Math.max(1, target.width - 1)
+      const targetY = targetComponent.centroidY / Math.max(1, target.height - 1)
