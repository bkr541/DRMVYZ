# Configure these with `supabase secrets set --env-file supabase/functions/.env.local`.
# Never prefix provider secrets with VITE_ and never commit the populated file.

GROQ_API_KEY=replace-with-server-secret
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Groq Whisper documents a 25 MiB file limit. DRMVYZ keeps direct requests
# below a separate 23 MiB application-safe threshold and targets 20 MiB
# browser-prepared chunks.
GROQ_MAX_AUDIO_BYTES=26214400
GROQ_SAFE_AUDIO_BYTES=24117248
GROQ_CHUNK_SAFETY_BYTES=262144
GROQ_TRANSCRIPTION_OVERLAP_MS=4000
GROQ_TRANSCRIPTION_CONCURRENCY=1
GROQ_PROVIDER_TIMEOUT_MS=180000

# Optional secure fallback for a source codec the browser cannot decode. Normal
# oversized MP3/M4A/AAC/FLAC/OGG/WAV tracks are prepared locally as private mono
# PCM WAV chunks and do not require this service.
LYRIC_TRANSCRIPTION_ENDPOINT=https://your-private-transcription-service.example/transcribe
LYRIC_TRANSCRIPTION_ENDPOINT_TOKEN=replace-with-server-secret
LYRIC_TRANSCRIPTION_CHUNK_MS=240000
LYRIC_TRANSCRIPTION_OVERLAP_MS=4000
