# Supabase — copy this file to .env and fill in your values
# NEVER commit .env to version control

# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Cast Stage 7 — deployment-specific, not saved-project state.
# Host native/output/google-cast/sender/index.html at this HTTPS URL.
DRMVYZ_GOOGLE_CAST_SENDER_URL=https://cast.example.com/drmvyz/sender/
# Register native/output/google-cast/receiver/index.html as a Custom Web Receiver,
# then set its 8-character application ID here.
DRMVYZ_GOOGLE_CAST_APP_ID=00000000
